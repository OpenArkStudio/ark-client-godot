; Open with the Godot .NET editor.
config_version=5

[application]
config/name="ARK Guest Room"
run/main_scene="res://Scenes/GuestRoom.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=824
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]
project/assembly_name="Ark.Client.Godot"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)
